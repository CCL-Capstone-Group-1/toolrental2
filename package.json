    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "prisma": "^7.9.1"
  },
  "allowScripts": {
    "@prisma/client@7.9.1": true,
